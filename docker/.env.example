# ===== finnav Docker 部署配置 =====
# 复制为 docker/.env，按需修改后执行：docker compose up -d --build

# 生产环境建议设为 True（关闭 Django DEBUG）
DEBUG=False

# 生产环境务必改为随机长字符串
SECRET_KEY=please-change-this-secret-key

# 允许访问的 Host（逗号分隔）；生产环境请改为具体域名/IP
ALLOWED_HOSTS=*

# CSRF 可信来源（逗号分隔，需含 scheme，如 https://fn.example.com）
# 接入域名/HTTPS 后若管理后台提交被 403 拒绝，请在此填入完整 origin
CSRF_TRUSTED_ORIGINS=

# Email（可选）：设置后通过 Resend 发送注册/找回密码验证码，
# 不设置则验证码打印到后端日志（日志：docker compose logs -f backend）
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# 数据库引擎：sqlite（默认，数据存 docker/data/db.sqlite3）| mysql | postgres
# 用 MySQL/PostgreSQL 时指向外部实例（不内置 DB 容器），DB 数据不存 docker/data。
DB_ENGINE=sqlite
DB_NAME=/srv/data/db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# 仅 MySQL：默认 utf8mb4（分类图标 emoji 需要）
DB_CHARSET=utf8mb4
# 连接复用秒数（mysql/postgres）
DB_CONN_MAX_AGE=60

# 对外唯一端口（默认 80）
PORT=80

# ===== 镜像仓库部署（服务器不本地构建）=====
# 服务器只 docker compose pull（不带 --build），镜像由 CI/开发机构建后推送到 GHCR。
# CI 默认推送到 ghcr.io/<owner>/finnav-{backend,frontend}；改仓库名后需同步改这里。
BACKEND_IMAGE=ghcr.io/cljproton/finnav-backend
FRONTEND_IMAGE=ghcr.io/cljproton/finnav-frontend

# ===== 前端 SPA 壳兜底 SEO（仅本地 --build 时生效，服务器拉镜像不受影响）=====
# canonical 根域名需与后端 AppSetting.share_base_url 一致；CI 构建则在 workflow
# 的 Run workflow 表单填写 seo_origin，默认值即下面填的域名。
SEO_ORIGIN=https://fn.9418666.xyz
SEO_TITLE=金融与 Web3 站点导航 | FinNav
SEO_DESCRIPTION=FinNav：一个金融与 Web3 站点导航，收录官网入口、APP 下载、新手教程与用户评价。