{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finnav-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finnav-db",
      "database_id": "REPLACE_WITH_REAL_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "finnav-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA",
        "class_name": "QuotaGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuotaGuard"]
    }
  ],
  "triggers": {
    "crons": ["0 17 * * *"]
  },
  "vars": {
    "APP_ENV": "dev"
  }
}
