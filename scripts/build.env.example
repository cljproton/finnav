# ===== FinNav 移动端 EAS 云端打包配置模板 =====
# 用法：复制本文件为 scripts/build.env 并按需修改；或用环境变量覆盖（环境变量优先级更高）。
# 所有变量均可选，留空使用脚本默认值。构建脚本：scripts/build_android.sh / scripts/build_ios.sh
#
# EAS 云端构建：本地不装 Android SDK / JDK / Xcode，代码上传到 EAS 云端完成编译与签名。
# 一次性前置（仅需一次）：
#   1) 登录：npx eas-cli login（CI 用 EXPO_TOKEN 环境变量）
#   2) 关联项目：(cd frontend && npx eas-cli init)
#   3) iOS 签名：npx eas-cli credentials（配置 Apple 开发者证书；Android keystore 首构建自动生成）

# 应用显示名（默认读 frontend/app.json 的 expo.name）
#APP_NAME=FinNav

# 版本号（默认读 frontend/app.json 的 expo.version）
#APP_VERSION=1.0.0

# ---- Android ----
# applicationId（默认 com.finnav.app）
#ANDROID_PACKAGE=com.finnav.app

# versionCode（默认由 APP_VERSION 自动推导，如 1.0.0 -> 10000）
#ANDROID_VERSION_CODE=10000

# ---- iOS ----
# bundleIdentifier（默认 com.finnav.app）
#IOS_BUNDLE_IDENTIFIER=com.finnav.app

# build 号（默认 1）
#IOS_BUILD_NUMBER=1

# ---- 打进包的后端 API 地址 ----
# 构建时该地址会写进 frontend/eas.json 对应 profile 的 env，云端 Metro 打包时内联进 App。
# 留空则用前端内置默认逻辑（web/真机跟随访问主机，Android 模拟器 10.0.2.2:8000）
#EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# ---- EAS 构建 profile（frontend/eas.json）----
# preview: distribution=internal + Android APK，可直装（默认，推荐日常调试）
# production: Android AAB / iOS Release，用于上架商店
#EAS_PROFILE=preview

# ---- 产物输出目录（相对仓库根目录；默认 frontend/build）----
#BUILD_OUTPUT_DIR=frontend/build

# Android 允许明文 HTTP：仅当后端为无 TLS 的 http://IP:8000 且仅限调试/内网时设为 1。
# 正式上架请使用 HTTPS（Android 9+ 默认拦截明文 HTTP；iOS 默认放行）
#ANDROID_ALLOW_CLEARTEXT=1

# ---- CI / 无交互环境 ----
# 设置后跳过 eas-cli login（npx eas-cli login 仍是一次性操作）
#EXPO_TOKEN=your_expo_access_token