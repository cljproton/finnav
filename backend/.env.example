# 复制本文件为 backend/.env 并按需修改。
# 说明: settings.py 会自动读取 backend/.env（系统环境变量优先）。

# 调试开关，生产环境必须设为 False
DEBUG=True

# 生产环境必须替换为随机长字符串（例如: python -c "import secrets; print(secrets.token_urlsafe(50))"）
SECRET_KEY=dev-only-key-change-me

# 允许访问的 Host，逗号分隔；开发默认 *
ALLOWED_HOSTS=*

# 数据库引擎：sqlite（默认）| mysql | postgres
DB_ENGINE=sqlite

# SQLite（DB_ENGINE=sqlite）数据库文件路径（相对 backend/ 目录或绝对路径）
DB_NAME=db.sqlite3

# MySQL / PostgreSQL（DB_ENGINE=mysql 或 postgres）
# DB_NAME=finnav
# DB_USER=finnav
# DB_PASSWORD=your-password
# DB_HOST=127.0.0.1
# DB_PORT=3306            # MySQL 默认 3306；PostgreSQL 默认 5432
# DB_CHARSET=utf8mb4      # 仅 MySQL：默认 utf8mb4，分类图标 emoji 需要它
# DB_CONN_MAX_AGE=60      # 连接复用秒数（SQLite 可忽略）
